rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'maleksameh121@gmail.com'
        ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isTeacher() {
      return signedIn()
        && userExists(request.auth.uid)
        && getUser(request.auth.uid).data.role == 'teacher'
        && getUser(request.auth.uid).data.status == 'active';
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.status == (
          request.resource.data.role == 'teacher' ? 'pending' : 'active'
        )
        && (
          request.auth.token.email == null
          || request.resource.data.email == request.auth.token.email
        );

      allow read: if isOwner(uid) || isAdmin()
        || (signedIn() && resource.data.role == 'teacher' && resource.data.status == 'active');

      // المستخدم يستطيع تعديل بياناته الأساسية فقط.
      // المستخدم يستطيع تعديل بياناته الأساسية المسموح بها فقط.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'fullName', 'phone', 'country', 'city', 'grade', 'studyGrade', 'className',
            'subject', 'photoURL', 'displayName', 'lastLoginAt', 'updatedAt', 'profileCompletedAt',
            'bio', 'whatsapp', 'teachingGrades', 'availableDays', 'availablePeriods', 'lessonModes'
          ])
        );

      allow delete: if isAdmin();
    }

    match /users/{uid}/fcmTokens/{tokenId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/library/{documentId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /loginLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /featuredStudents/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /libraryBooks/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // سجل تنزيلات الكتب: المستخدم يسجل تنزيله بنفسه، والأدمن فقط يقرأ السجل.
    match /libraryDownloads/{downloadId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.bookTitle is string
        && request.resource.data.bookUrl is string
        && request.resource.data.source in ['general', 'azhar']
        && request.resource.data.bookTitle.size() > 0
        && request.resource.data.bookTitle.size() <= 250
        && request.resource.data.bookUrl.size() <= 2048;
      allow read, update, delete: if isAdmin();
    }

    match /azharBooks/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if isAdmin();

      allow read: if signedIn()
        && resource.data.audience == 'all';

      allow read: if signedIn()
        && resource.data.audience == 'user'
        && resource.data.targetUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.audience == 'admin'
        && request.resource.data.studentUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.audience == 'user'
        && resource.data.targetUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []));

      allow update: if signedIn()
        && resource.data.audience == 'all'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []));
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.section in [
          'القرآن الكريم',
          'التزكية والتربية',
          'اللغة العربية',
          'العلوم الشرعية',
          'التعليم الأزهري',
          'البرمجة وتكنولوجيا المعلومات'
        ]
        && request.resource.data.subject is string
        && request.resource.data.lessonType is string
        && request.resource.data.preferredDay1 is string
        && request.resource.data.preferredDay2 is string
        && request.resource.data.preferredPeriod is string
        && request.resource.data.lessonMode in ['أونلاين', 'حضوري']
        && request.resource.data.status == 'جديد'
        && request.resource.data.source == 'booking';

      allow read: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid)
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      allow update: if isAdmin()
        || (
          isTeacher()
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status is string
          && request.resource.data.status.size() <= 40
        );

      allow delete: if isAdmin();
    }

    // سجل تغييرات حالات الحجوزات للتقارير. الأدمن يملك الإدارة الكاملة،
    // والمعلم المعتمد يستطيع فقط تسجيل تغيير حالة حجز مُعيّن له.
    match /bookingStatusHistory/{historyId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (
          isTeacher()
          && request.resource.data.changedByUid == request.auth.uid
          && request.resource.data.bookingId is string
          && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.teacherUid == request.auth.uid
        );
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    match /questionBank/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /lessonRatings/{ratingId} {
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow read, update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid;
      allow read: if isAdmin()
        || isTeacher()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /lessonAttendance/{attendanceId} {
      allow create: if (signedIn() && request.resource.data.studentUid == request.auth.uid)
        || isAdmin()
        || (isTeacher()
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.studentUid is string);

      allow read: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid)
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // واجبات المعلم للطلاب المرتبطين به.
    match /teacherHomeworks/{homeworkId} {
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.studentUid is string;

      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);

      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // ملاحظات المعلم: الخاصة للمعلم والإدارة، ويمكن إظهار ملاحظات مختارة للطالب.
    match /teacherStudentNotes/{noteId} {
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.studentUid is string;
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid && resource.data.visibleToStudent == true);
      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    match /libraryProgress/{progressId} {
      allow read: if signedIn() && resource.data.studentUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.studentUid == request.auth.uid;
    }

    match /publicStats/{statId} {
      allow read: if true;
      allow create, update: if isAdmin() && statId in ['students', 'books', 'categories', 'tests'];

      allow create: if statId == 'students'
        && signedIn()
        && request.resource.data.total == 1
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && getAfter(/databases/$(database)/documents/studentCounterClaims/$(request.auth.uid)).data.uid == request.auth.uid;

      allow update: if statId == 'students'
        && signedIn()
        && request.resource.data.total == resource.data.total + 1
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && getAfter(/databases/$(database)/documents/studentCounterClaims/$(request.auth.uid)).data.uid == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /studentCounterClaims/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'student';
      allow read: if isOwner(uid) || isAdmin();
      allow update, delete: if isAdmin();
    }


    match /studyQuestions/{questionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['studentUid','studentName','question','status','reply','createdAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() > 2
        && request.resource.data.question.size() <= 500
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 90
        && request.resource.data.status == 'pending'
        && request.resource.data.reply == ''
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
