    // ====== ZAD STORE: collections isolated from academy finances ======
    match /storeSettings/{settingId} {
      allow get: if settingId == 'main' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /storeProducts/{productId} {
      allow get, list: if isAdmin()
        || resource.data.published == true
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        function hasCourseAccess() {
          return signedIn()
            && exists(/databases/$(database)/documents/storeEntitlements/$(productId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/storeEntitlements/$(productId + '_' + request.auth.uid)).data.active == true;
        }
        allow get: if isAdmin() || resource.data.freePreview == true || hasCourseAccess();
        allow list: if isAdmin() || hasCourseAccess();
        allow create, update, delete: if isAdmin();
      }
    }


    // External source URLs must never be published as public catalog fields.
    // An approved purchase is the only way a student can read their URL here.
    match /storeProductLinks/{productId} {
      function hasApprovedOrder() {
        return signedIn()
          && exists(/databases/$(database)/documents/storeEntitlements/$(request.auth.uid + '_' + productId))
          && get(/databases/$(database)/documents/storeEntitlements/$(request.auth.uid + '_' + productId)).data.studentUid == request.auth.uid
          && get(/databases/$(database)/documents/storeEntitlements/$(request.auth.uid + '_' + productId)).data.active == true;
      }
      allow get: if isAdmin() || hasApprovedOrder();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['url','source','updatedAt','updatedBy'])
        && request.resource.data.url is string
        && request.resource.data.url.size() >= 8
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('^https://[^ ]+$');
      allow delete: if isAdmin();
    }

    match /storeOrders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'studentUid','buyerEmail','buyerName','productIds','paymentMethod',
          'senderPhone','paymentReference','note','proofPath','couponCode','status','createdAt'
        ])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.buyerEmail == (request.auth.token.email == null ? '' : request.auth.token.email)
        && request.resource.data.buyerName is string
        && request.resource.data.buyerName.size() > 0
        && request.resource.data.buyerName.size() <= 120
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() >= 1
        && request.resource.data.productIds.size() <= 40
        && request.resource.data.paymentMethod in ['vodafone-cash','instapay']
        && request.resource.data.senderPhone is string
        && request.resource.data.senderPhone.matches('^01[0-9]{9}$')
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 4
        && request.resource.data.paymentReference.size() <= 100
        && request.resource.data.couponCode is string
        && request.resource.data.couponCode.size() <= 32
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.proofPath is string
        && (request.resource.data.proofPath == ''
           || request.resource.data.proofPath == 'storeProofs/' + request.auth.uid + '/' + orderId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow get, list: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /storePaymentRefs/{refHash} {
      allow read, create, update, delete: if isAdmin();
    }

    match /storeEntitlements/{entitlementId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /storeTeacherDrafts/{draftId} {
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly([
          'teacherUid','courseId','title','position','description',
          'videoUrl','status','createdAt'
        ])
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.courseId is string
        && exists(/databases/$(database)/documents/storeProducts/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/storeProducts/$(request.resource.data.courseId)).data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/storeProducts/$(request.resource.data.courseId)).data.type == 'course'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.position is int
        && request.resource.data.position >= 1
        && request.resource.data.position <= 999
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 2048
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /storeProgress/{progressId} {
      function allowedOwner() {
        return signedIn()
          && resource.data.studentUid == request.auth.uid;
      }
      function enrolled(productId) {
        return exists(/databases/$(database)/documents/storeEntitlements/$(productId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/storeEntitlements/$(productId + '_' + request.auth.uid)).data.active == true;
      }
      allow read: if isAdmin() || allowedOwner();
      allow create: if signedIn()
        && progressId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && enrolled(request.resource.data.productId)
        && request.resource.data.completedLessonIds is list
        && request.resource.data.completedLessonIds.size() <= 500;
      allow update: if signedIn()
        && allowedOwner()
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.productId == resource.data.productId
        && enrolled(resource.data.productId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedLessonIds','updatedAt'])
        && request.resource.data.completedLessonIds is list
        && request.resource.data.completedLessonIds.size() <= 500;
      allow delete: if isAdmin();
    }

    match /storeCoupons/{couponCode} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
